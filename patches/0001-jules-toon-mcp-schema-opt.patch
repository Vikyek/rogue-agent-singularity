 src/patterns.py       | 14 ++++++++++----
 src/toon_converter.py | 11 +++++++----
 2 files changed, 17 insertions(+), 8 deletions(-)

diff --git a/src/patterns.py b/src/patterns.py
index 2a3069d..1b65f1d 100644
--- a/src/patterns.py
+++ b/src/patterns.py
@@ -271,12 +271,18 @@ class PatternDetector:
         if not arr:
             return 0.0

-        # Get all unique key sets
-        key_sets = [set(item.keys()) for item in arr if isinstance(item, dict)]
-
-        if not key_sets:
+        valid_items = [item for item in arr if isinstance(item, dict)]
+        if not valid_items:
             return 0.0

+        # Fast path for perfectly homogeneous arrays
+        first_keys = valid_items[0].keys()
+        if all(item.keys() == first_keys for item in valid_items):
+            return 1.0
+
+        # Get all unique key sets
+        key_sets = [set(item.keys()) for item in valid_items]
+
         # Calculate consistency based on key overlap
         all_keys = set.union(*key_sets)
         common_keys = set.intersection(*key_sets)
diff --git a/src/toon_converter.py b/src/toon_converter.py
index 6fa0fd0..a93915a 100644
--- a/src/toon_converter.py
+++ b/src/toon_converter.py
@@ -177,11 +177,14 @@ class TOONConverter:
         if not arr:
             return []

-        if all(isinstance(item, dict) for item in arr):
-            key_sets = [set(item.keys()) for item in arr]
-            if len({tuple(sorted(ks)) for ks in key_sets}) == 1:
+        # Optimization: use fast dict_keys comparison instead of sets and tuples to avoid O(N) redundant allocations
+        first_item = arr[0]
+        if isinstance(first_item, dict):
+            first_keys = first_item.keys()
+            # Fast fail check if all items are dicts with the same keys as the first item
+            if all(isinstance(item, dict) and item.keys() == first_keys for item in arr):
                 # All objects have identical keys — encode as schema + value rows
-                keys = sorted(arr[0].keys())
+                keys = sorted(first_keys)
                 compressed_keys = [self._abbrev_key(k) for k in keys]
                 return {
                     '_sch': compressed_keys,
