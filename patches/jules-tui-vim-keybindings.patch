From 80dfa68cd86e4319377f56369333260c025157bb Mon Sep 17 00:00:00 2001
From: Google Labs Jules <jules@google.com>
Date: Tue, 1 Sep 2026 13:53:29 +0200
Subject: [PATCH] =?UTF-8?q?=F0=9F=8E=A8=20Palette:=20Dynamic=20TUI=20coordinates=20and=20vim=20keybindings?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
diff --git a/jules_tui.py b/jules_tui.py
index cc0f53c..1711785 100755
--- a/jules_tui.py
+++ b/jules_tui.py
@@ -40,7 +40,8 @@ def draw_menu(stdscr):
     selected_idx = 0
     sessions_cache = []
     last_fetch = 0
-    status_msg = "Press 'r' to refresh, 'a' to archive, 'm' to cycle mode, 'q' to quit."
+    status_msg = "Ready."
+    shortcuts_msg = "Keys: [↑/k] up | [↓/j] down | [r]efresh | [a]rchive | [m]ode | [Enter] reply | [q]uit"
     cfg = load_config()

     while True:
@@ -93,18 +94,22 @@ def draw_menu(stdscr):

         # Footer / Command bar
         stdscr.attron(curses.color_pair(1))
-        stdscr.addstr(height - 2, 2, status_msg[:width-4])
+        stdscr.addstr(height - 3, 2, status_msg[:width-4])
         stdscr.attroff(curses.color_pair(1))

+        stdscr.attron(curses.color_pair(3))
+        stdscr.addstr(height - 2, 2, shortcuts_msg[:width-4])
+        stdscr.attroff(curses.color_pair(3))
+
         stdscr.refresh()
         stdscr.timeout(1000)
         key = stdscr.getch()

         if key in (ord('q'), ord('Q')):
             break
-        elif key == curses.KEY_UP and selected_idx > 0:
+        elif (key == curses.KEY_UP or key in (ord('k'), ord('K'))) and selected_idx > 0:
             selected_idx -= 1
-        elif key == curses.KEY_DOWN and selected_idx < len(sessions_cache) - 1:
+        elif (key == curses.KEY_DOWN or key in (ord('j'), ord('J'))) and selected_idx < len(sessions_cache) - 1:
             selected_idx += 1
         elif key in (ord('r'), ord('R')):
             last_fetch = 0
@@ -133,10 +138,12 @@ def prompt_reply(stdscr, session_id):
     curses.echo()
     curses.curs_set(1)
     stdscr.addstr(height - 3, 2, " " * (width - 4))
-    stdscr.addstr(height - 3, 2, f"Enter response for [{session_id[:12]}]: ", curses.color_pair(3) | curses.A_BOLD)
+    prompt_str = f"Enter response for [{session_id[:12]}]: "
+    stdscr.addstr(height - 3, 2, prompt_str, curses.color_pair(3) | curses.A_BOLD)
     stdscr.refresh()

-    msg_bytes = stdscr.getstr(height - 3, 36, width - 40)
+    prompt_len = len(prompt_str) + 2
+    msg_bytes = stdscr.getstr(height - 3, prompt_len, width - prompt_len - 4)
     curses.noecho()
     curses.curs_set(0)

--
2.53.0
