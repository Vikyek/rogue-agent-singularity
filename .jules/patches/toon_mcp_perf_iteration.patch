diff --git a/src/patterns.py b/src/patterns.py
index 2a3069d..55a4f04 100644
--- a/src/patterns.py
+++ b/src/patterns.py
@@ -228,25 +228,15 @@ class PatternDetector:

         structure_hashes: Counter = Counter()

-        def hash_structure(obj: Any) -> Optional[str]:
-            """Create a hash of object structure."""
-            if isinstance(obj, dict):
-                return '|'.join(sorted(obj.keys()))
-            return None
-
-        def collect_structures(d: Any):
-            """Collect all structure hashes."""
-            if isinstance(d, dict):
-                h = hash_structure(d)
-                if h:
-                    structure_hashes[h] += 1
-                for v in d.values():
-                    collect_structures(v)
-            elif isinstance(d, list):
-                for item in d:
-                    collect_structures(item)
-
-        collect_structures(data)
+        stack = [data]
+        while stack:
+            current = stack.pop()
+            if isinstance(current, dict):
+                if current:
+                    structure_hashes['|'.join(sorted(current.keys()))] += 1
+                stack.extend(current.values())
+            elif isinstance(current, list):
+                stack.extend(current)

         # Find repeated structures
         for structure, count in structure_hashes.items():
@@ -272,12 +262,15 @@ class PatternDetector:
             return 0.0

         # Get all unique key sets
-        key_sets = [set(item.keys()) for item in arr if isinstance(item, dict)]
-
-        if not key_sets:
+        valid_items = [item for item in arr if isinstance(item, dict)]
+        if not valid_items:
             return 0.0

-        # Calculate consistency based on key overlap
+        first_keys = valid_items[0].keys()
+        if all(item.keys() == first_keys for item in valid_items):
+            return 1.0
+
+        key_sets = [set(item.keys()) for item in valid_items]
         all_keys = set.union(*key_sets)
         common_keys = set.intersection(*key_sets)

diff --git a/src/toon_converter.py b/src/toon_converter.py
index 6fa0fd0..5b8d200 100644
--- a/src/toon_converter.py
+++ b/src/toon_converter.py
@@ -107,13 +107,14 @@ class TOONConverter:

     def _build_ref_cache(self, data: Any) -> None:
         """Traverse data and collect key frequencies for aggressive-mode abbreviation."""
-        if isinstance(data, dict):
-            for key, value in data.items():
-                self.key_freq[key] += 1
-                self._build_ref_cache(value)
-        elif isinstance(data, list):
-            for item in data:
