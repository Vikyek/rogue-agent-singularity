#!/usr/bin/env bash
# vras-submodule — Simple CLI to list, enable, disable, or toggle VRAS submodules
# Usage: vras-submodule [list|enable|disable|toggle] [module]

set -euo pipefail

# Locate VRAS root directory (supports symlinks and global installs)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
if [ -n "${VRAS_ROOT:-}" ]; then
    :
elif [ -d "$SCRIPT_DIR/.git" ]; then
    VRAS_ROOT="$SCRIPT_DIR"
elif [ -d "$HOME/.gemini/config/plugins/rogue-agent-singularity/.git" ]; then
    VRAS_ROOT="$HOME/.gemini/config/plugins/rogue-agent-singularity"
elif [ -d "$HOME/Projects/rogue-agent-singularity/.git" ]; then
    VRAS_ROOT="$HOME/Projects/rogue-agent-singularity"
elif [ -d "/usr/share/rogue-agent-singularity" ]; then
    VRAS_ROOT="/usr/share/rogue-agent-singularity"
elif [ -d "/usr/local/share/rogue-agent-singularity" ]; then
    VRAS_ROOT="/usr/local/share/rogue-agent-singularity"
else
    VRAS_ROOT="$PWD"
fi

cd "$VRAS_ROOT"

# Available module mappings
declare -A MODULES=(
    ["dispatcher"]="agv-dispatcher"
    ["agv-dispatcher"]="agv-dispatcher"
    ["jules"]="jules-vanager"
    ["jules-vanager"]="jules-vanager"
    ["sync"]="agv-syncengine"
    ["agv-syncengine"]="agv-syncengine"
    ["toon"]="toon-mcp"
    ["toon-mcp"]="toon-mcp"
)

# Canonical module list
ALL_MODULES=("agv-dispatcher" "jules-vanager" "agv-syncengine" "toon-mcp")

# Status check helper
is_enabled() {
    local mod="$1"
    local status="${2:-}"

    if [ -z "$status" ]; then
        status=$(git submodule status "$mod" 2>/dev/null || echo "-")
    fi

    if [[ "$status" =~ ^- ]]; then
        return 1
    else
        return 0
    fi
}

cmd_list() {
    echo "🌌 Vikyek's Rogue Agent Singularity — Submodules:"
    echo ""

    # Optimize: pre-fetch status of all submodules once
    local all_status
    all_status=$(git submodule status 2>/dev/null || true)

    for mod in "${ALL_MODULES[@]}"; do
        # Extract the line for this specific module from the pre-fetched status
        local mod_line
        mod_line=$(echo "$all_status" | grep -E "[[:space:]]$mod([[:space:]]|$)" || echo "-")

        # Pass the extracted line to is_enabled to avoid a redundant git call
        if is_enabled "$mod" "$mod_line"; then
            # Extract commit hash from the line, preserving any + or U prefixes as in original script
            local commit_hash
            commit_hash=$(echo "$mod_line" | awk '{print $1}')
            printf "  \e[32m● ENABLED \e[0m %-20s (%s)\n" "$mod" "$commit_hash"
        else
            printf "  \e[31m○ DISABLED\e[0m %-20s (uninitialized)\n" "$mod"
        fi
    done
    echo ""
}

cmd_enable() {
    local target="${1:-all}"
    if [ "$target" = "all" ]; then
        for mod in "${ALL_MODULES[@]}"; do
            echo "Activating $mod..."
            git submodule update --init --recursive "$mod"
        done
    else
        local mod="${MODULES[$target]:-$target}"
        echo "Activating $mod..."
        git submodule update --init --recursive "$mod"
    fi
    cmd_list
}

cmd_disable() {
    local target="${1:-all}"
    if [ "$target" = "all" ]; then
        for mod in "${ALL_MODULES[@]}"; do
            echo "Deactivating $mod..."
            git submodule deinit -f "$mod" 2>/dev/null || true
        done
    else
        local mod="${MODULES[$target]:-$target}"
        echo "Deactivating $mod..."
        git submodule deinit -f "$mod"
    fi
    cmd_list
}

cmd_toggle() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo "Usage: vras-submodule toggle <module>"
        exit 1
    fi
    local mod="${MODULES[$target]:-$target}"
    if is_enabled "$mod"; then
        cmd_disable "$mod"
    else
        cmd_enable "$mod"
    fi
}

# Command dispatch
ACTION="${1:-list}"
MODULE="${2:-}"

case "$ACTION" in
    list|status)
        cmd_list
        ;;
    enable|on|add)
        cmd_enable "$MODULE"
        ;;
    disable|off|rm|remove)
        cmd_disable "$MODULE"
        ;;
    toggle|switch)
        cmd_toggle "$MODULE"
        ;;
    -h|--help|help)
        echo "Usage: vras-submodule [list|enable|disable|toggle] [module]"
        echo ""
        echo "Commands:"
        echo "  list                     Show status of all submodules"
        echo "  enable  <module|all>     Enable and initialize submodule"
        echo "  disable <module|all>     Disable and deinitialize submodule"
        echo "  toggle  <module>         Toggle module on or off"
        echo ""
        echo "Modules: dispatcher, jules, sync, toon, all"
        ;;
    *)
        cmd_toggle "$ACTION"
        ;;
esac
